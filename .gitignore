# ===== parano1d-break =====
# Uniform scheme: new experiment lanes are covered automatically. The rule of thumb
# is "source and reports are tracked; everything a build, a cargo fetch, a web fetch,
# or a running node produces is not." If a lane ever needs a genuine deliverable that
# matches one of these patterns, force it in with `git add -f <path>`.

# --- build artifacts & vendored toolchains (any lane, any depth) ---
target/
target-*/
.cargo-home*/
__pycache__/
*.pyc
*.crate

# --- per-lane bulk: target-checkout copies, fetched blobs, run data, logs, compiled
#     binaries. Scoped to a lane's top level (experiments/<lane>/<dir>/) so that
#     src/ and src/bin/ Rust sources stay tracked. ---
experiments/*/pinned/
experiments/*/*-src/
experiments/*/source/
experiments/*/repos/
experiments/*/downloads/
experiments/*/packs/
experiments/*/logs/
experiments/*/run/
experiments/*/bin/
experiments/*/fixture/
experiments/*/tmp/
experiments/*/probes/

# --- raw web-reconnaissance fetches (HTML/JS pulled from explorers, pools, etc.) ---
experiments/*/*.html
experiments/*/*.js
experiments/network-status/jetsam-*.md

# --- the target checkout itself: read-only reference, reproducible from the pinned
#     commit in PROVENANCE.md; never committed into the audit repo. ---
parano1d/
